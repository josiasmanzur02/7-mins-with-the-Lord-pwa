<!DOCTYPE html>
<html lang="<%= lang %>" data-theme="<%= 'light' %>">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover"
    />
    <meta name="color-scheme" content="light dark" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <link rel="manifest" href="<%= asset('manifest.json') %>" />
    <link rel="icon" href="<%= asset('icons/logo.svg') %>" type="image/svg+xml" />
    <meta name="theme-color" content="#f3f7fb" />
    <link rel="stylesheet" href="<%= asset('css/style.css') %>" />
    <title>7 Minutes with the Lord</title>
    <script>
      window.I18N_ALL = <%- JSON.stringify(translations) %>;
      window.I18N_LANG = '<%= lang %>';
      window.I18N = window.I18N_ALL[window.I18N_LANG] || window.I18N_ALL.en;
      window.APP_PAGE = '<%= typeof pageName !== "undefined" ? pageName : "" %>';
      window.APP_DEPTH = <%= typeof appDepth !== "undefined" ? appDepth : 0 %>;
    </script>
  </head>
  <body class="<%= typeof bodyClass !== 'undefined' ? bodyClass : '' %>">
    <div class="shell">
      <header class="topbar">
        <div class="brand">
          <span class="logo-dot"></span>
          <span class="brand-name"><%= t('brand') %></span>
        </div>
        <button class="nav-toggle" aria-label="<%= t('nav_toggle') %>">☰</button>
        <nav class="nav">
          <a href="<%= route('home') %>"><%= t('nav_home') %></a>
          <a href="<%= route('timer') %>"><%= t('nav_start') %></a>
          <a href="<%= route('settings') %>"><%= t('nav_settings') %></a>
          <a href="<%= route('install') %>"><%= t('nav_install') %></a>
        </nav>
      </header>

      <% if (flash) { %>
        <div class="flash <%= flash.type %>"><%= flash.message %></div>
      <% } %>

      <main>
